{
  "name": "anvil",
  "version": "0.1.6",
  "description": "Desktop control plane for running coding agents in parallel Git worktrees and reviewing their diffs.",
  "main": "./out/main/index.js",
  "author": "lucasignaciopirito@gmail.com",
  "license": "Apache-2.0",
  "scripts": {
    "test:e2e": "playwright test",
    "test:issue-tracker": "vitest run",
    "postinstall": "electron-rebuild -f -o better-sqlite3,node-pty",
    "dev": "node scripts/dev.cjs",
    "demo": "node scripts/capture-demo.mjs",
    "build": "npm run typecheck && npm run build:server && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/drizzle.cjs migrate",
    "memory:generate": "drizzle-kit generate --config drizzle.memory.config.ts",
    "memory:migrate": "drizzle-kit migrate --config drizzle.memory.config.ts",
    "memory:inspect": "node scripts/memory-inspect.mjs",
    "db:drop": "node scripts/db-drop.cjs",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "start": "npm run build:server && electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release.mjs",
    "pack:mac": "npm run build && electron-builder --mac --dir -c.mac.identity=null",
    "dist:mac": "npm run build && electron-builder --mac dmg -c.mac.identity=null",
    "rebuild": "electron-builder install-app-deps",
    "test:vitest": "vitest run",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "build:server": "node scripts/build-server.mjs",
    "serve": "npm run build:server && node scripts/serve.cjs",
    "rebuild:headless": "node scripts/prepare-headless-native.cjs",
    "serve:headless": "npm run build:server && node scripts/serve.cjs --headless",
    "serve:headless:tailscale": "npm run build:server && node scripts/serve.cjs --headless --tailscale"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pierre/diffs": "^1.4.0",
    "@tanstack/react-virtual": "^3.14.11",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fuzzysort": "^3.1.0",
    "ghostty-web": "^0.4.0",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "esbuild": "^0.28.2",
    "node-gyp": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
