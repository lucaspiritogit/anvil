{
  "extends": "./tsconfig.node.json",
  "include": [
    "vitest.config.mts",
    "tests/**/*.ts",
    "apps/web/src/env.d.ts"
  ],
  "exclude": [
    "tests/e2e/**"
  ],
  "compilerOptions": {
    "composite": false,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vitest/importMeta"
    ],
    "paths": {
      "@anvil/app-data": ["./packages/app-data/src/index.ts"],
      "@anvil/client-api": ["./packages/client-api/src/index.ts"],
      "@anvil/protocol/*": ["./packages/protocol/src/*"],
      "@dither-kit/*": ["./apps/web/src/components/dither-kit/*"],
      "@renderer/*": ["./apps/web/src/*"]
    }
  }
}
