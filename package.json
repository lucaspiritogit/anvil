{
  "name": "anvil",
  "version": "0.1.0",
  "description": "An agentic development platform. No chats, clear tasks.",
  "main": "./out/main/index.js",
  "author": "lucasignaciopirito@gmail.com",
  "license": "MIT",
  "scripts": {
    "test:e2e": "playwright test",
    "test:issue-tracker": "node scripts/test-issue-tracker.mjs",
    "postinstall": "electron-rebuild -f -o better-sqlite3 && node scripts/fix-pty-permissions.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/drizzle.cjs migrate",
    "memory:generate": "drizzle-kit generate --config drizzle.memory.config.ts",
    "memory:migrate": "drizzle-kit migrate --config drizzle.memory.config.ts",
    "memory:inspect": "node scripts/memory-inspect.mjs",
    "db:drop": "node scripts/db-drop.cjs",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@pierre/diffs": "^1.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^7.0.92",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "node-pty": "^1.0.0",
    "pg": "^8.23.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "valence": "file:vendor/valence-0.1.0.tgz",
    "vite": "^5.4.11"
  }
}
