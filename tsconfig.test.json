{
  "extends": "./tsconfig.node.json",
  "include": [
    "vitest.config.mts",
    "tests/**/*.ts",
    "src/client/renderer/src/env.d.ts"
  ],
  "exclude": [
    "tests/e2e/**"
  ],
  "compilerOptions": {
    "composite": false,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vitest/importMeta"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  }
}
