{
  "include": ["package.json", "apps/web/**/*", "packages/client-api/**/*", "packages/protocol/**/*", "tests/e2e/fixture/app.tsx", "tests/e2e/fixture/accounts.ts", "tests/e2e/fixture/task-events.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@anvil/client-api": ["./packages/client-api/src/index.ts"],
      "@anvil/protocol/*": ["./packages/protocol/src/*"],
      "@dither-kit/*": ["./apps/web/src/components/dither-kit/*"],
      "@renderer/*": ["./apps/web/src/*"],
      "@public/*": ["./public/*"]
    }
  }
}
