{
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/shared/**/*", "tests/e2e/fixture/app.tsx", "tests/e2e/fixture/accounts.ts", "tests/e2e/fixture/task-events.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@public/*": ["./public/*"]
    }
  }
}
