{
  "include": [
    "apps/server/**/*",
    "apps/desktop/electron.vite.config.ts",
    "apps/desktop/src/main/**/*",
    "apps/desktop/src/preload/**/*",
    "packages/app-data/**/*",
    "packages/client-api/**/*",
    "packages/protocol/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@anvil/app-data": ["./packages/app-data/src/index.ts"],
      "@anvil/client-api": ["./packages/client-api/src/index.ts"],
      "@anvil/protocol/*": ["./packages/protocol/src/*"]
    }
  }
}
