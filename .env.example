# Memory is off by default. Enable it in Settings > Memory.
# When enabled, the default backend is embedded PGlite. Use "postgres" for a
# self-hosted database, or "disabled" to disable the backend regardless of settings.
ANVIL_MEMORY_BACKEND=pglite

# Required only when ANVIL_MEMORY_BACKEND=postgres.
ANVIL_MEMORY_DATABASE_URL=postgresql://anvil:anvil@localhost:5432/anvil_memory

# Defaults for Settings > Memory. Desktop preferences are persisted in SQLite.
# The environment values remain fallbacks for standalone memory adapters.
# Ollama's OpenAI-compatible endpoint and local 1024-dimensional embedding model.
ANVIL_OLLAMA_BASE_URL=http://localhost:11434/v1
ANVIL_MEMORY_EMBEDDING_MODEL=mxbai-embed-large

# Optional absolute app-data directory for isolated tests. Unset defaults to
# ~/.anvil-composer-dev for source runs and ~/.anvil-composer for packaged apps.
# ANVIL_DATA_DIR=/tmp/anvil-test

# Optional password file for unattended npm run serve:headless startup.
# Without it, the first terminal launch asks for a password and saves its hash.
# serve:headless:tailscale uses Tailscale access and does not read this file.
# ANVIL_SERVER_PASSWORD_FILE=/absolute/path/to/anvil-password
