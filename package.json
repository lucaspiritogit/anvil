{
  "name": "anvil",
  "version": "1.0.3",
  "description": "Desktop control plane for running coding agents in parallel Git worktrees and reviewing their diffs.",
  "main": "./out/main/index.js",
  "author": "lucasignaciopirito@gmail.com",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "postinstall": "electron-rebuild -f -o node-pty",
    "dev": "npm run build:server && node scripts/dev.cjs",
    "demo": "node scripts/capture-demo.mjs",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "npm run build:server && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/maintenance.cjs migrate",
    "memory:generate": "drizzle-kit generate --config drizzle.memory.config.ts",
    "memory:migrate": "drizzle-kit migrate --config drizzle.memory.config.ts",
    "memory:inspect": "node scripts/maintenance.cjs memory",
    "db:drop": "node scripts/maintenance.cjs drop",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "start": "npm run build:app && electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release.mjs",
    "pack:mac": "npm run build && electron-builder --mac --dir -c.mac.identity=null",
    "dist:mac": "npm run build && electron-builder --mac dmg -c.mac.identity=null",
    "rebuild": "electron-builder install-app-deps",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "build:server": "vite build --config vite.server.config.ts",
    "package:server": "npm run build:app && node scripts/package-server.mjs",
    "serve": "npm run build:server && node out/server/index.js --headless",
    "serve:lan": "npm run build:server && node out/server/index.js --headless --lan",
    "serve:tailscale": "npm run build:server && node out/server/index.js --headless --tailscale"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@pierre/diffs": "^1.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.11",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "esbuild": "^0.28.2",
    "fuzzysort": "^3.1.0",
    "ghostty-web": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.2"
  }
}
