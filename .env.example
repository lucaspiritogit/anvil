# The desktop default is embedded PGlite. Use "postgres" for a self-hosted or
# managed PostgreSQL database, or "disabled" to turn project memory off.
ANVIL_MEMORY_BACKEND=pglite

# Required only when ANVIL_MEMORY_BACKEND=postgres.
ANVIL_MEMORY_DATABASE_URL=postgresql://anvil:anvil@localhost:5432/anvil_memory

# Ollama's OpenAI-compatible endpoint and local embedding model.
ANVIL_OLLAMA_BASE_URL=http://localhost:11434/v1
ANVIL_MEMORY_EMBEDDING_MODEL=mxbai-embed-large
