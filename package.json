{
  "name": "anvil",
  "version": "0.1.0",
  "description": "An agentic development platform. No chats, clear tasks.",
  "main": "./out/main/index.js",
  "author": "lucasignaciopirito@gmail.com",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-rebuild -f -o better-sqlite3 && node scripts/fix-pty-permissions.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:drop": "node scripts/db.cjs drop",
    "db:reset": "node scripts/db.cjs reset",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@pierre/diffs": "^1.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "node-pty": "^1.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
